def std::can_fail =
  !sh <$args[0] -c r#"
    xsim -c - "$@" || true
  "#
    -- $args[1;]
;

def trnl = !tr <$args[0] -d "\n" $args[1;];
def pwd = trnl(!pwd $args);
def print = !printf "%s" $args;
def pwd/ = print $pwd /$args;
def test = {
  can_fail "HI"; # Fails, not a valid xs script
  can_fail r###"
    # Hello, this is normal xs-script. No escaping worries,
    # cox I have infinite ### raw strings.

    !rm /; # will fail
  "###;

  can_fail r####"
    # Omg call again the script!
    include_str this.dust ./include/dust.2/std/can_fail.dust;
    # Notice how cooly xsim allows script's CWD to be base-dir
    # for static file imports (yes, these imports are static: the
    # loaded file is loaded at compile time, a missing file is a
    # compile error, and the content is baked into the bytecode,
    # so the file is never accessed at runtime: becomes static
    # data). The CWD integration is a recent improvement, part
    # the unified xsim tool which aims to give predictable behaviour
    # in all edge cases.
    !pwd;

    # Compile a static dust script
    let obj = !xsim <$this.dust -c -o -;
    # List the functions
    !xsim <$obj --list_funcs_to=-;
  "####;

  can_fail r###"
    !xxd <(!printenv X=(!echo 9) X);
  "###
}
# Note the end ';' in free-standing scripts,
# (main-body). There is a bug that the last instruction
# is not collected if it's the return expr of the block,
# so we need to turn it to a stmt so that it gets collected,
# and thus executed, before the end of the script. Record this
# as a bug in TODO and add to our goals and TODOs.

# Note on input redirection:
# Input redirection is pretty advanced in dust.
# one can use: - strings, - streams, and a mix of
# eveything, multiple times. The process receives
# a concatenation of everything-as-bytestream, in the
# order in which they are declared in command line.
# Example, concat two streams:
def example::concat2 = {
  let a = $args[0]; # These types of let-s (and def-s) are pure aliases.
  let b = $args[1]; # The compiler gets it, and they create no overhead.
  !cat
    <$a # Redirect a, directly.
    <(!cat <$b) # Redirect b, through another cat, just for demonstration.
}

# Note on streams:
# A stream is generally consumed after used once, and the
# value becomes "null" under the hood. It's a very noval language
# feature: silent-value-swap :sclap:.
def example::EVIL::reuse_stream_is_bad = {
  src a = !echo hi;
  # spawns "echo hi", its output stream is
  # the process' output stream, no middleware.
  # `a` is the handle to that output.
  # It's dangling, it's possibly blocking the process, coz
  # nobody is ready its stdout and if its trying to
  # write, then it's blocked.

  !cat <$a;
  # OK
  # spawns a "cat" with its stdin directly connected
  # (fs-pipe; in rust, ChildStdOut as input to ChildStdInput).
  # Also (!!) after this point $a is `null`.

  !echo $a; # ERROR: $a is a null value
}

# Note on values:
# On the other hand, using `let` bindings collects the data
# in memory, as a buffer. It can be read and copied as much
# as needed. It's dynamic heap data.
def example::let_binding = {
  let obj = !xsim <"!echo hi;" -c -o -;

  # Use obj as much as like
  !xsim <$obj;
  !xsim <$obj;
  !cat
    <(!xsim <$obj)
    <(!xsim <$obj)
  ;

  # Just remember not to cause infinite loops :sy:
}


