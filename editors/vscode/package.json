{
  "name": "dust-lang",
  "displayName": "Dust Language",
  "description": "Syntax highlighting and LSP support for the Dust scripting language",
  "version": "0.1.0",
  "publisher": "dusk",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:dust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dust",
        "aliases": ["Dust", "dust"],
        "extensions": [".dust"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dust",
        "scopeName": "source.dust",
        "path": "./syntaxes/dust.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Dust Language",
      "properties": {
        "dust.lsp.path": {
          "type": "string",
          "default": "dust-lsp",
          "description": "Path to the dust-lsp binary"
        },
        "dust.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Dust language server"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
