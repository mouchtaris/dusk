include ../include/dust.2/std/...;
def ci::build =
  !cargo
    build --release
      --bin xsi
      --bin xsim
      --bin xs-call
      --bin xs-compile
      --bin xs-debug
      --bin xs-decompile
      --bin xs-link
      --bin xs-run
      --bin xsi-list-func
;

def ci::bin.tar =
  !tar @./target/release
    --create
    --
      xsi
      xsim
      xs-call
      xs-compile
      xs-debug
      xs-decompile
      xs-link
      xs-run
      xsi-list-func
;

def ci::include.tar =
  !tar @./include --create -- ./dust.2
;

def ci::install/local = {
  def i dest tar = {
    let target = env HOME /.local/ $dest;

    !echo Installing to $target ...;
    !mkdir -p $target;
    src files = !tar @$target <$tar --extract --verbose;
    !xargs @$target <$files -- lsd -al --;
  }
  def a = i bin       $bin.tar;
  def b = i "include" $include.tar;

  src a = a;
  src b = b;
  let _ = !cat <$a <$b;
}
