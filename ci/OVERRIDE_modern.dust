## --------------------------------------------------------------- ##
include ../include/dust.2/std/...;

## --------------------------------------------------------------- ##
def ci::build =
  !cargo
    build --release
      --bin xsi
      --bin xsim
      --bin xs-call
      --bin xs-compile
      --bin xs-debug
      --bin xs-decompile
      --bin xs-link
      --bin xs-run
      --bin xsi-list-func
;

def ci::bin.tar =
  !tar @./target/release
    --create
    --
      xsi
      xsim
      xs-call
      xs-compile
      xs-debug
      xs-decompile
      xs-link
      xs-run
      xsi-list-func
;

def ci::include.tar =
  !tar @./include --create -- ./dust.2
;

## --------------------------------------------------------------- ##
def ci::install/specific target_prefix dest tar = {
    let target = p $target_prefix $dest;

    !echo Installing to $target ...;
    !mkdir -p $target;
    src files = !tar @$target <$tar --extract --verbose;
    !xargs @$target <$files -- lsd -al --;
}

def ci::install/by prefix = !cat
  <(specific $prefix bin       $bin.tar     )
  <(specific $prefix "include" $include.tar )
;

def ci::prefix/local  = env HOME /.local/;
def ci::prefix/system = "/usr/";

def ci::install/local   = by $prefix/local;
def ci::install/system  = by $prefix/system;

## --------------------------------------------------------------- ##
def ci::uninstall/specific prefix dest tar = {
  let target = p $prefix $dest;

  !echo Uninstalling from $target ...;
  src files = !tar <$tar --list;
  src files = !grep <$files -v "/$";
  !xargs @$target <$files -- rm -v --;
}

def ci::uninstall/by prefix = !cat
  <(specific $prefix bin        $bin.tar)
  <(specific $prefix "include"  $include.tar)
;

def ci::uninstall/local   = by $prefix/local;
def ci::uninstall/system  = by $prefix/system;
